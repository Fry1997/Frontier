{
  "_comment": "The request ledger (design↔code pipeline contract §1). One entry per outstanding asset. CODE keeps building against procedural placeholders under the same assetId; DESIGN fills these in whenever ready. Status lifecycle: requested → in_progress → delivered → accepted|rejected → integrated.",
  "requests": [
    {
      "requestId": "REQ-0001",
      "assetId": "player.arthur",
      "status": "requested",
      "type": "character_sheet",
      "purpose": "Player character; replaces the procedural Arthur. Highest-value asset in the game — the eye judges the character hardest and procedural does it worst (handover §9).",
      "spec": {
        "frameSize": { "w": 32, "h": 48 },
        "states": [
          { "name": "idle", "frames": 1, "directions": ["down", "up", "left", "right"] },
          { "name": "walk", "frames": 4, "directions": ["down", "up", "left", "right"] },
          { "name": "act", "frames": 2, "directions": ["down", "up", "left", "right"] }
        ],
        "anchor": "bottom_center",
        "sheetLayout": "grid_by_state",
        "palette": "theme_agnostic",
        "format": "png_rgba"
      },
      "naming": "arthur.png + arthur.json atlas ({state}_{dir} -> frame rects)",
      "integratesAt": "assets/sprites/player/",
      "priority": "high",
      "constraints": [
        "match the ~32x48 footprint of the current procedural sprite (feet at bottom_center)",
        "readable at 3x scale (game renders pixel-doubled+)",
        "left may be delivered as mirrored right if the design has no asymmetric details — note it in deviations if so",
        "act frames carry the tool swing: frame 0 = raised, frame 1 = struck (hit lands between them)"
      ]
    },
